using Gtk 4.0;
using Adw 1;

template $TemporalExplorerWindow : Adw.ApplicationWindow {
  title: _("Temporal Explorer");
  default-width: 1100;
  default-height: 700;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.OverlaySplitView split_view {
      min-sidebar-width: 260;
      max-sidebar-width: 320;
      sidebar-width-fraction: 0.25;

      sidebar: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [start]
          Button timeline_back_button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Back");
            visible: false;
            styles ["flat"]
          }

          title-widget: Adw.WindowTitle timeline_header_title {
            title: _("Timeline");
          };
        }

        content: Box {
          orientation: vertical;

          // Search bar + filter toggle — declared here so the widget tree
          // is fully described in Blueprint without any imperative injection.
          Box {
            orientation: horizontal;
            spacing: 0;
            margin-start: 8;
            margin-end: 8;
            margin-top: 8;
            margin-bottom: 8;

            SearchEntry commit_search_entry {
              placeholder-text: _("Search commits, hash, date\u2026");
              hexpand: true;
            }

            ToggleButton filter_button {
              icon-name: "funnel-symbolic";
              tooltip-text: _("Filters");
              styles ["flat"]
            }
          }

          Stack timeline_stack {
            vexpand: true;
            transition-type: slide_left_right;
            transition-duration: 200;

            StackPage {
              name: "years";
              child: ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;
                ListBox year_list {
                  selection-mode: single;
                  styles ["navigation-sidebar"]
                }
              };
            }

            StackPage {
              name: "months";
              child: ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;
                ListBox month_list {
                  selection-mode: single;
                  styles ["navigation-sidebar"]
                }
              };
            }

            StackPage {
              name: "commits";
              child: ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;
                ListBox commit_list {
                  selection-mode: single;
                  styles ["navigation-sidebar"]
                }
              };
            }
          }
        };
      };

      content: Adw.ToolbarView content_toolbar_view {
        [top]
        $TemporalToolbar toolbar {}

        content: Stack right_panel_stack {
          transition-type: crossfade;
          transition-duration: 150;
          vexpand: true;
          hexpand: true;

          StackPage {
            name: "empty";
            child: Box {
              orientation: vertical;

              Adw.WindowTitle window_title {
                title: _("Temporal Explorer");
                subtitle: _("No repository selected");
                visible: false;
              }

              Adw.StatusPage empty_state {
                icon-name: "folder-symbolic";
                title: _("No Snapshot Selected");
                description: _("Open a Git repository and select a commit from the timeline to browse its file tree.");
                vexpand: true;
                hexpand: true;
              }
            };
          }

          StackPage {
            name: "content";
            child: Box right_panel_content {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
            };
          }
        };

        [bottom]
        Gtk.ActionBar commit_info_bar {
          revealed: false;

          [start]
          Label commit_hash_label {
            styles ["monospace"]
          }

          [start]
          Label commit_message_label {
            ellipsize: end;
            max-width-chars: 60;
          }

          [end]
          Label commit_date_label {
            styles ["dim-label"]
          }
        }
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("_About Temporal Explorer");
      action: "app.about";
    }
  }
}
