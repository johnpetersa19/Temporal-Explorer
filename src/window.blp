using Gtk 4.0;
using Adw 1;

template $TemporalExplorerWindow : Adw.ApplicationWindow {
  title: _("Temporal Explorer");
  default-width: 1100;
  default-height: 700;
  show-menubar: false;

  styles [
    "view",
  ]

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.OverlaySplitView split_view {
      enable-show-gesture: false;
      enable-hide-gesture: false;
      max-sidebar-width: 240;
      min-sidebar-width: 240;
      sidebar-width-fraction: 0.2;

      sidebar: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-start-title-buttons: true;
          show-end-title-buttons: true;

          [start]
          Button timeline_back_button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Back");
            visible: false;
            styles ["flat"]
          }

          title-widget: Adw.WindowTitle timeline_header_title {
            title: _("Timeline");
          };
        }

        content: Box {
          orientation: vertical;

          // Search bar + filter toggle — declared here so the widget tree
          // is fully described in Blueprint without any imperative injection.
          Box {
            orientation: horizontal;
            spacing: 0;
            margin-start: 8;
            margin-end: 8;
            margin-top: 8;
            margin-bottom: 8;

            SearchEntry commit_search_entry {
              placeholder-text: _("Search commits, hash, date…");
              hexpand: true;
            }

            ToggleButton filter_button {
              icon-name: "nautilus-search-filters-symbolic";
              tooltip-text: _("Filters");
              styles ["flat"]
            }
          }

          Stack timeline_stack {
            vexpand: true;
            transition-type: slide_left_right;
            transition-duration: 200;

            StackPage {
              name: "years";
              child: ScrolledWindow {
                hadjustment: Adjustment {};
                vadjustment: Adjustment {};
                vexpand: true;
                hscrollbar-policy: never;
                ListBox year_list {
                  selection-mode: single;
                  styles ["navigation-sidebar"]
                }
              };
            }

            StackPage {
              name: "months";
              child: ScrolledWindow {
                hadjustment: Adjustment {};
                vadjustment: Adjustment {};
                vexpand: true;
                hscrollbar-policy: never;
                ListBox month_list {
                  selection-mode: single;
                  styles ["navigation-sidebar"]
                }
              };
            }

            StackPage {
              name: "commits";
              child: ScrolledWindow {
                hadjustment: Adjustment {};
                vadjustment: Adjustment {};
                vexpand: true;
                hscrollbar-policy: never;
                ListBox commit_list {
                  selection-mode: single;
                  styles ["navigation-sidebar"]
                }
              };
            }
          }
        };
      };

      content: Adw.ToolbarView content_toolbar_view {
        [top]
        $TemporalToolbar toolbar {}

        [top]
        Adw.TabBar tab_bar {
          view: tab_view;
          autohide: false;
          expand-tabs: true;
        }

        content: Adw.TabView tab_view {
          vexpand: true;
          hexpand: true;
        };

        [bottom]
        Gtk.ActionBar commit_info_bar {
          revealed: false;

          [start]
          Label commit_hash_label {
            styles ["monospace"]
          }

          [start]
          Label commit_message_label {
            ellipsize: end;
            max-width-chars: 60;
          }

          [end]
          Button {
            label: _("Restore Project Files…");
            tooltip-text: _("Restore the project files from this snapshot without changing the current branch");
            action-name: "win.restore-project-snapshot";
            styles ["suggested-action"]
          }

          [end]
          Label commit_date_label {
            styles ["dim-label"]
          }
        }
      };
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 682sp")

    setters {
      split_view.collapsed: true;
      split_view.enable-show-gesture: true;
      split_view.enable-hide-gesture: true;
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("_About Temporal Explorer");
      action: "app.about";
    }
  }
}
