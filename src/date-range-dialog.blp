//! Port / inspiration: nautilus-date-range-dialog.blp (GNOME Nautilus 47+).
//! Adapted from a file-date filter into a Git commit-date range filter.

using Gtk 4.0;
using Adw 1;

template $DateRangeDialog : Adw.Dialog {
  title: _("Custom Date Range");
  content-height: 380;
  content-width: 420;
  default-widget: apply_button;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      title-widget: Adw.WindowTitle {
        title: _("Filter by Date Range");
      };

      [start]
      Button cancel_button {
        label: _("_Cancel");
        use-underline: true;
        action-name: "window.close";
      }
    }

    content: Adw.PreferencesPage {

      Adw.PreferencesGroup {
        title: _("Date Range");
        description: _("Show only commits authored within this period (YYYY-MM-DD)");

        Adw.EntryRow from_entry {
          title: _("From");
          input-purpose: free-form;
          input-hints: no_spellcheck;
        }

        Adw.EntryRow to_entry {
          title: _("To");
          input-purpose: free-form;
          input-hints: no_spellcheck;
        }
      }

      Adw.PreferencesGroup error_group {
        visible: false;

        Adw.ActionRow error_row {
          title: _("Invalid date");
          subtitle: _("Use the format YYYY-MM-DD, e.g. 2026-01-15");
          icon-name: "dialog-warning-symbolic";

          styles ["error"]
        }
      }

      Adw.PreferencesGroup {
        Button apply_button {
          label: _("_Apply Filter");
          use-underline: true;
          margin-top: 8;
          halign: center;
          sensitive: false;

          styles ["suggested-action", "pill"]
        }
      }
    };
  };
}
