using Gtk 4.0;
using Adw 1;

menu primary_menu {
  section {
    item {
      label: _("New _Window");
      action: "win.new-window";
      verb-icon: "window-new-symbolic";
    }

    item {
      label: _("New _Tab");
      action: "win.new-tab";
      verb-icon: "tab-new-symbolic";
    }

    item {
      label: _("Show All Ta_bs");
      action: "win.open-tab-overview";
    }
  }

  section undo_redo_section {
    item { label: _("_Undo"); action: "win.undo"; }
    item { label: _("_Redo"); action: "win.redo"; }
  }

  section {
    item {
      label: _("Open Repository…");
      action: "win.open-repository";
      accel: "<control>o";
    }

    item {
      label: _("Clone Repository…");
      action: "win.clone-repository";
    }

    item {
      label: _("New Branch…");
      action: "win.new-branch";
    }

    item {
      label: _("Reload");
      action: "win.reload-repository";
      accel: "F5";
    }
  }

  section {
    submenu {
      label: _("Location");

      section {
        item {
          label: _("Edit Snapshot Location");
          action: "win.edit-location";
          accel: "<control>l";
        }

        item {
          label: _("Go to Snapshot Root");
          action: "win.prompt-root-location";
          accel: "/";
        }

        item {
          label: _("Copy Snapshot Location");
          action: "win.copy-current-location";
        }
      }
    }

    submenu {
      label: _("Repository");

      section {
        item {
          label: _("Open Repository in System");
          action: "win.open-repository-system";
        }

        item {
          label: _("Open in Console");
          action: "win.open-repository-console";
        }

        item {
          label: _("Copy Repository Path");
          action: "win.copy-current-repository-path";
        }
      }
    }
  }

  section {
    submenu {
      label: _("Selection");

      section {
        item {
          label: _("Select All");
          action: "win.select-all-files";
          accel: "<control>a";
        }

        item {
          label: _("Invert Selection");
          action: "win.invert-file-selection";
          accel: "<control><shift>a";
        }

        item {
          label: _("Clear Selection");
          action: "win.unselect-all-files";
        }
      }
    }

    submenu {
      label: _("View");

      section {
        item {
          label: _("Captions…");
          action: "win.show-captions";
        }

        item {
          label: _("Visible Columns…");
          action: "win.show-column-chooser";
        }

        item {
          label: _("Select Commits by Pattern…");
          action: "win.select-by-pattern";
        }
      }
    }

    submenu {
      label: _("File");

      section {
        item {
          label: _("Properties");
          action: "win.current-properties";
        }

        item {
          label: _("Preview Selected File");
          action: "win.preview-selected-file";
        }

        item {
          label: _("Show Context Menu");
          action: "win.open-context-menu";
        }
      }
    }

    submenu {
      label: _("Operations");

      section {
        item {
          label: _("Restore Project Files from Snapshot…");
          action: "win.restore-project-snapshot";
        }

        item {
          label: _("Export Snapshot Archive…");
          action: "win.export-snapshot-archive";
        }

        item {
          label: _("Batch Operations…");
          action: "win.batch-operations";
        }

        item {
          label: _("Compare Merge Parents…");
          action: "win.show-merge-conflicts";
        }
      }
    }
  }

  section {
    item {
      label: _("Favorite Snapshots");
      action: "win.show-favorites";
    }

    item {
      label: _("Search Snapshot Contents");
      action: "win.search-snapshot-content";
    }

    item {
      label: _("Recent Operations");
      action: "win.show-operation-history";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_Help");
      action: "app.help";
    }

    item {
      label: _("_About Temporal Explorer");
      action: "app.about";
    }
  }
}


menu tab_menu_model {
  section {
    item {
      label: _("_New Tab");
      action: "win.new-tab";
    }

    item {
      label: _("Re_store Closed Tab");
      action: "win.restore-closed-tab";
    }
  }

  section {
    item {
      label: _("Move Tab to New _Window");
      action: "win.move-tab-to-new-window";
    }

    item {
      /* Translators: use “Move Tab _Right” for RTL languages */
      label: _("Move Tab _Left");
      action: "win.move-tab-left";
    }

    item {
      /* Translators: use “Move Tab _Left” for RTL languages */
      label: _("Move Tab _Right");
      action: "win.move-tab-right";
    }
  }

  section {
    item {
      label: _("_Close Tab");
      action: "win.close-tab";
    }

    item {
      label: _("Close _Other Tabs");
      action: "win.close-other-tabs";
    }
  }
}

menu tab_overview_menu_model {
  section {
    item {
      label: _("New _Window");
      action: "win.new-window";
    }

    item {
      label: _("Re_store Closed Tab");
      action: "win.restore-closed-tab";
    }
  }
}

template $TemporalExplorerWindow : Adw.ApplicationWindow {
  title: _("Temporal Explorer");
  default-width: 1024;
  default-height: 640;
  width-request: 360;
  height-request: 294;
  show-menubar: false;

  styles [
    "view",
  ]

  content: Adw.TabOverview tab_overview {
    view: tab_view;
    enable-new-tab: true;
    secondary-menu: tab_overview_menu_model;

    child: Adw.ToastOverlay toast_overlay {
      child: Adw.OverlaySplitView split_view {
        enable-show-gesture: false;
        enable-hide-gesture: false;
        sidebar-width-fraction: 0.25;
        min-sidebar-width: 240;
        max-sidebar-width: 340;
        show-sidebar: true;

        sidebar: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Button timeline_back_button {
              icon-name: "go-previous-symbolic";
              tooltip-text: _("Back");
              visible: false;
            }

            [start]
            Button forward_button {
              icon-name: "go-forward-symbolic";
              tooltip-text: _("Next commit");
              action-name: "win.next-commit";
              visible: false;
            }

            [start]
            ToggleButton sidebar_search_button {
              icon-name: "nautilus-edit-find";
              tooltip-text: _("Search Commits");
            }

            title-widget: Adw.WindowTitle timeline_header_title {
              title: _("Timeline");
            };

            [end]
            Button star_button {
              icon-name: "starred";
              tooltip-text: _("Add to Favorites");
              action-name: "win.star-snapshot";
            }

            [end]
            MenuButton sidebar_menu_button {
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              menu-model: primary_menu;
            }
          }

          [bottom]
          ActionBar sidebar_bottom_bar {
            revealed: false;

            [start]
            MenuButton progress_indicator_button {
              tooltip-text: _("Show Operations");
              direction: right;
              hexpand: true;
              styles [
                "flat",
                "temporal-progress-indicator",
              ]

              child: Box {
                spacing: 9;

                Image progress_indicator_icon {
                  icon-name: "document-open-recent-symbolic";
                  pixel-size: 14;
                  margin-start: 3;
                }

                Label operation_status_label {
                  label: _("No operations");
                  ellipsize: end;
                  hexpand: true;
                  xalign: 0;
                }

                ProgressBar operation_progress_bar {
                  visible: false;
                  width-request: 72;
                  valign: center;
                  show-text: false;
                  fraction: 0.0;
                }
              };

              popover: Popover operations_popover {
                child: ScrolledWindow {
                  hscrollbar-policy: never;
                  max-content-height: 270;
                  propagate-natural-height: true;

                  child: ListBox operations_list {
                    margin-start: 6;
                    margin-end: 6;
                    margin-top: 6;
                    margin-bottom: 6;
                    selection-mode: none;
                    activate-on-single-click: false;
                    styles [
                      "operations-list",
                    ]
                  };
                };
              };
            }

            [end]
            Button operation_cancel_button {
              icon-name: "cancel-operation-symbolic";
              tooltip-text: _("Cancel Operation");
              action-name: "win.cancel-operation";
              styles [
                "flat",
              ]
            }

            [end]
            Button operation_close_button {
              icon-name: "window-close-symbolic";
              tooltip-text: _("Hide Operations");
              action-name: "win.close-operation-panel";
              styles [
                "flat",
              ]
            }
          }

          content: Box {
            orientation: vertical;

            Revealer sidebar_search_revealer {
              reveal-child: false;
              transition-type: slide_down;
              transition-duration: 150;

              Box {
                orientation: horizontal;
                spacing: 0;
                margin-start: 8;
                margin-end: 8;
                margin-top: 8;
                margin-bottom: 8;

                SearchEntry commit_search_entry {
                  placeholder-text: _("Search commits, hash, date…");
                  hexpand: true;
                }

                ToggleButton filter_button {
                  icon-name: "nautilus-search-filters-symbolic";
                  tooltip-text: _("Filters");
                  styles [
                    "flat",
                  ]
                }
              }
            }

            Stack timeline_stack {
              vexpand: true;
              transition-type: slide_left_right;
              transition-duration: 200;

              StackPage {
                name: "years";
                child: ScrolledWindow {
                  hadjustment: Adjustment {};
                  vadjustment: Adjustment {};
                  vexpand: true;
                  hscrollbar-policy: never;
                  ListBox year_list {
                    selection-mode: single;
                    styles [
                      "navigation-sidebar",
                    ]
                  }
                };
              }

              StackPage {
                name: "months";
                child: ScrolledWindow {
                  hadjustment: Adjustment {};
                  vadjustment: Adjustment {};
                  vexpand: true;
                  hscrollbar-policy: never;
                  ListBox month_list {
                    selection-mode: single;
                    styles [
                      "navigation-sidebar",
                    ]
                  }
                };
              }

              StackPage {
                name: "commits";
                child: ScrolledWindow {
                  hadjustment: Adjustment {};
                  vadjustment: Adjustment {};
                  vexpand: true;
                  hscrollbar-policy: never;
                  ListBox commit_list {
                    selection-mode: single;
                    styles [
                      "navigation-sidebar",
                    ]
                  }
                };
              }
            }
          };
        };

        content: Adw.ToolbarView content_toolbar_view {
          [top]
          $TemporalToolbar toolbar {}

          [top]
          Adw.TabBar tab_bar {
            view: tab_view;
          }

          content: Adw.TabView tab_view {
            vexpand: true;
            hexpand: true;
            menu-model: tab_menu_model;
          };

          [bottom]
          Box {
            orientation: vertical;

            Gtk.ActionBar commit_info_bar {
              revealed: false;

              [start]
              Label commit_hash_label {
                styles [
                  "monospace",
                ]
              }

              [start]
              Label commit_message_label {
                ellipsize: end;
                max-width-chars: 60;
              }

              [end]
              Button {
                label: _("Restore Project Files…");
                tooltip-text: _("Restore the project files from this snapshot without changing the current branch");
                action-name: "win.restore-project-snapshot";
                styles [
                  "suggested-action",
                ]
              }

              [end]
              Label commit_date_label {
                styles [
                  "dim-label",
                ]
              }
            }

            Gtk.ActionBar mobile_controls_bar {
              revealed: false;

              [start]
              $HistoryControls mobile_history_controls {}

              [end]
              $ViewControls mobile_view_controls {}

              [end]
              Adw.TabButton tab_button {
                view: tab_view;
                action-name: "win.open-tab-overview";
              }
            }
          }
        };
      };
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 682sp")

    setters {
      split_view.collapsed: true;
      split_view.enable-show-gesture: true;
      split_view.enable-hide-gesture: true;
      tab_bar.visible: false;
      mobile_controls_bar.revealed: true;
      operations_popover.position: top;
      toolbar.show-sidebar-button: true;
      toolbar.show-view-controls: false;
      toolbar.show-history-controls: false;
    }
  }
}
