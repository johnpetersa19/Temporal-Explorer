using Gtk 4.0;
using Adw 1;

template $NodePropertiesDialog : Adw.Dialog {
  title: _("Properties");
  content-width: 480;
  content-height: 620;

  styles [
    "nautilus-properties",
  ]

  child: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationView nav_view {
      Adw.NavigationPage {
        title: _("Properties");
        tag: "main";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-title: false;

            [start]
            Button favorite_button {
              icon-name: "non-starred-symbolic";
              tooltip-text: _("Star");
              valign: center;

              styles [
                "star",
              ]
            }

            [end]
            Button open_location_button {
              icon-name: "external-link-symbolic";
              tooltip-text: _("Open Location");
            }
          }

          content: Adw.PreferencesPage {
            Adw.PreferencesGroup {
              Box {
                orientation: vertical;
                spacing: 12;

                CenterBox {
                  [center]
                  Adw.Bin {
                    width-request: 96;
                    height-request: 96;

                    child: Image icon_image {
                      pixel-size: 96;
                      icon-name: "text-x-generic-symbolic";
                      halign: center;
                      valign: center;

                      styles [
                        "icon-dropshadow",
                      ]
                    };
                  }
                }

                Box {
                  orientation: vertical;
                  spacing: 6;

                  Label name_label {
                    label: "";
                    selectable: true;
                    ellipsize: end;
                    max-width-chars: 28;
                    wrap: true;
                    wrap-mode: word_char;
                    lines: 3;
                    justify: center;

                    styles [
                      "title-3",
                    ]
                  }

                  Label kind_label {
                    label: "";
                    ellipsize: end;
                    selectable: true;
                    justify: center;
                  }

                  Label summary_label {
                    label: "";
                    ellipsize: end;
                    selectable: true;
                    justify: center;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                }
              }
            }

            Adw.PreferencesGroup {
              Adw.ActionRow parent_folder_row {
                title: _("Parent _Folder");
                selectable: false;
                subtitle-selectable: true;
                use-underline: true;
                use-markup: false;

                styles [
                  "property",
                ]

                [suffix]
                Button copy_path_button {
                  icon-name: "edit-copy-symbolic";
                  tooltip-text: _("Copy Path");
                  valign: center;

                  styles [
                    "flat",
                  ]
                }

                [suffix]
                Button open_parent_folder_button {
                  icon-name: "folder-open-symbolic";
                  tooltip-text: _("Open Parent Folder");
                  valign: center;

                  styles [
                    "flat",
                  ]
                }
              }

              Adw.ActionRow repository_row {
                title: _("Repository");
                selectable: false;
                subtitle-selectable: true;
                use-markup: false;

                styles [
                  "property",
                ]
              }

              Adw.ActionRow system_status_row {
                title: _("Working Tree");
                selectable: false;
                subtitle-selectable: true;
                use-markup: false;

                styles [
                  "property",
                ]
              }
            }

            Adw.PreferencesGroup {
              Adw.ActionRow modified_row {
                title: _("Modified");
                selectable: false;
                subtitle-selectable: true;
                subtitle-lines: 1;
                use-markup: false;

                styles [
                  "property",
                  "numeric",
                ]
              }

              Adw.ActionRow created_row {
                title: _("Created");
                selectable: false;
                subtitle-selectable: true;
                subtitle-lines: 1;
                use-markup: false;

                styles [
                  "property",
                  "numeric",
                ]
              }
            }

            Adw.PreferencesGroup {
              Adw.ActionRow permissions_row {
                title: _("_Permissions");
                use-underline: true;
                activatable: true;

                [suffix]
                Label permissions_label {
                  label: "";
                  valign: center;

                  styles [
                    "dim-label",
                  ]
                }

                [suffix]
                Image {
                  icon-name: "go-next-symbolic";
                  valign: center;

                  styles [
                    "dim-label",
                  ]
                }
              }

              Adw.ActionRow snapshot_row {
                title: _("Git Snapshot");
                selectable: false;
                subtitle-selectable: true;
                subtitle-lines: 1;
                use-markup: false;

                styles [
                  "property",
                  "numeric",
                ]

                [suffix]
                Button copy_sha_button {
                  icon-name: "edit-copy-symbolic";
                  tooltip-text: _("Copy Commit SHA");
                  valign: center;

                  styles [
                    "flat",
                  ]
                }
              }

              Adw.ActionRow object_row {
                title: _("Git Object");
                selectable: false;
                subtitle-selectable: true;
                subtitle-lines: 1;
                use-markup: false;

                styles [
                  "property",
                  "numeric",
                ]

                [suffix]
                Button copy_object_button {
                  icon-name: "edit-copy-symbolic";
                  tooltip-text: _("Copy Object Hash");
                  valign: center;

                  styles [
                    "flat",
                  ]
                }
              }
            }

            Adw.PreferencesGroup {
              Adw.ButtonRow copy_details_row {
                title: _("_Copy Details");
                use-underline: true;
                start-icon-name: "edit-copy-symbolic";
              }
            }
          };
        };
      }

      Adw.NavigationPage {
        title: _("Permissions");
        tag: "permissions";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.PreferencesPage {
            Adw.PreferencesGroup {
              title: _("Git Tree Mode");
              description: _("Git snapshots record POSIX tree mode bits instead of full filesystem ACLs.");

              Adw.ActionRow mode_octal_row {
                title: _("Mode");
                selectable: false;
                subtitle-selectable: true;
                use-markup: false;

                styles [
                  "property",
                  "numeric",
                ]
              }

              Adw.ActionRow mode_type_row {
                title: _("Object Kind");
                selectable: false;
                subtitle-selectable: true;
                use-markup: false;

                styles [
                  "property",
                ]
              }

              Adw.ActionRow mode_exec_row {
                title: _("Executable");
                selectable: false;
                subtitle-selectable: true;
                use-markup: false;

                styles [
                  "property",
                ]
              }
            }

            Adw.PreferencesGroup {
              title: _("Snapshot Integrity");

              Adw.ActionRow perm_commit_row {
                title: _("Full Commit SHA");
                selectable: false;
                subtitle-selectable: true;
                use-markup: false;

                styles [
                  "property",
                  "numeric",
                ]
              }

              Adw.ActionRow perm_object_row {
                title: _("Git Object Hash");
                selectable: false;
                subtitle-selectable: true;
                use-markup: false;

                styles [
                  "property",
                  "numeric",
                ]
              }
            }
          };
        };
      }
    };
  };
}
