using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Navigation");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go Back");
      accelerator: "<Alt>Left";
      direction: ltr;
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go Back");
      accelerator: "<Alt>Right";
      direction: rtl;
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go Forward");
      accelerator: "<Alt>Right";
      direction: ltr;
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go Forward");
      accelerator: "<Alt>Left";
      direction: rtl;
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go Up");
      accelerator: "<Alt>Up";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to First Commit");
      accelerator: "<Primary>Home";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to Latest Commit (HEAD)");
      accelerator: "<Primary>End";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Open Repository");
      accelerator: "<Primary>O";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "New Window");
      accelerator: "<Primary>N";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "New Tab");
      accelerator: "<Primary>T";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Close Tab");
      accelerator: "<Primary>W";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Restore Closed Tab");
      accelerator: "<Primary><Shift>T";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Show All Tabs");
      accelerator: "<Primary><Shift>O";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Refresh / Reload");
      accelerator: "F5";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Edit Snapshot Location");
      accelerator: "<Primary>L";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to Snapshot Root");
      accelerator: "slash";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Search & Filter");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Search Commits");
      accelerator: "<Primary>F";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Open Filter Popover");
      accelerator: "<Primary><Shift>F";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Open Date Range Dialog");
      accelerator: "<Primary><Shift>D";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Filter by File Type");
      accelerator: "<Primary><Alt>T";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Clear All Filters");
      accelerator: "<Primary>Escape";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "View");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "List View");
      accelerator: "<Primary>1";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Grid View");
      accelerator: "<Primary>2";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Show Hidden Files");
      accelerator: "<Primary>H";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Zoom In");
      accelerator: "<Primary>plus";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Zoom Out");
      accelerator: "<Primary>minus";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Reset Zoom");
      accelerator: "<Primary>0";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Show/Hide Sidebar");
      accelerator: "F9";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Choose Visible Columns");
      accelerator: "<Primary><Shift>C";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "File Grid Captions");
      accelerator: "<Primary><Shift>G";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Commit & File Actions");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Add/Remove Favorite");
      accelerator: "<Primary>D";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Copy Commit SHA");
      accelerator: "<Primary>C";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Show Commit Details");
      accelerator: "<Primary>I";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Preview Selected File");
      accelerator: "space";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Open Context Menu");
      accelerator: "<Shift>F10";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Batch Operations on Commits");
      accelerator: "<Primary><Shift>B";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Compare Merge Parents");
      accelerator: "<Primary><Shift>M";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Selection");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Select All Files");
      accelerator: "<Primary>A";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Invert File Selection");
      accelerator: "<Primary><Shift>A";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Clear File Selection");
      accelerator: "<Primary><Shift>L";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Select Commits Matching Pattern");
      accelerator: "<Primary>S";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Invert Commit Selection");
      accelerator: "<Primary><Shift>I";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "App");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Preferences");
      accelerator: "<Primary>comma";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Keyboard Shortcuts");
      accelerator: "<Primary>question";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Help");
      accelerator: "F1";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Quit");
      accelerator: "<Primary>Q";
    }
  }
}
