using Gtk 4.0;
using Adw 1;

template $SshPassphraseDialog : Adw.Dialog {
  title: _("Authentication Required");
  content-width: 440;
  content-height: 460;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;

      child: Adw.Clamp {
        maximum-size: 420;
        margin-top: 18;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

      Box {
        orientation: vertical;
        spacing: 24;

        Adw.StatusPage {
          icon-name: "channel-secure-symbolic";
          title: _("Enter Passphrase");
          description: _("This repository requires authentication.");
        }

        Adw.PreferencesGroup {
          Adw.PasswordEntryRow passphrase_entry {
            title: _("Passphrase");
          }
        }

        Box {
          orientation: horizontal;
          spacing: 8;
          homogeneous: true;

          Button cancel_button {
            label: _("Cancel");
            styles ["pill"]
          }

          Button confirm_button {
            label: _("Confirm");
            styles ["pill", "suggested-action"]
          }
        }
      }
      };
    };
  }
}
