//
// Dialog to toggle which captions appear below grid-view file thumbnails.
// Port of nautilus-grid-view-captions-dialog.

using Gtk 4.0;
using Adw 1;

template $FileGridCaptionsDialog : Adw.Dialog {
  title: _("Grid Captions");
  content-width: 340;
  content-height: 320;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: _("Grid View Captions");
      };

      [end]
      Button apply_button {
        label: _("_Apply");
        use-underline: true;
        can-shrink: true;
        clicked => $on_apply_clicked() swapped;

        styles ["suggested-action"]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        title: _("Visible Captions");
        description: _("Choose which information appears below each file in grid view.");

        Adw.SwitchRow caption_status_row {
          title: _("Status");
          subtitle: _("Added, Modified or Deleted");
        }

        Adw.SwitchRow caption_extension_row {
          title: _("Extension");
        }

        Adw.SwitchRow caption_size_row {
          title: _("File Size");
        }

        Adw.SwitchRow caption_date_row {
          title: _("Date Modified");
        }
      }
    };
  };
}
