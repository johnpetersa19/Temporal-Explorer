using Gtk 4.0;
using Adw 1;

template $SshPassphraseDialog : Adw.Dialog {
  title: _("Authentication Required");
  content-width: 380;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.Clamp {
      maximum-size: 380;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;

      Box {
        orientation: vertical;
        spacing: 24;

        Adw.StatusPage {
          icon-name: "channel-secure-symbolic";
          title: _("Enter Passphrase");
          description: _("This repository requires authentication.");
        }

        Adw.PreferencesGroup {
          Adw.PasswordEntryRow passphrase_entry {
            title: _("Passphrase");
          }
        }

        Box {
          orientation: horizontal;
          spacing: 8;
          homogeneous: true;

          Button cancel_button {
            label: _("Cancel");
            styles ["pill"]
          }

          Button confirm_button {
            label: _("Confirm");
            styles ["pill", "suggested-action"]
          }
        }
      }
    };
  }
}
