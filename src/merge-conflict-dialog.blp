using Gtk 4.0;
using Adw 1;

template $MergeConflictDialog: Adw.Dialog {
  title: _("Compare Merge Parents");
  content-width: 640;
  content-height: 560;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("_Close");
        use-underline: true;
        clicked => $on_cancel_clicked() swapped;
      }

      title-widget: Adw.WindowTitle {
        title: _("Compare Merge Parents");
        subtitle: _("Inspect changes combined by this merge commit");
      };
    }

    content: Box {
      orientation: vertical;
      spacing: 0;

      // ── File info banner ──────────────────────────────────────────────
      Adw.Banner conflict_banner {
        title: _("This file differs between the two merge parents.");
        button-label: _("Show Diff");
        action-name: "dialog.show-diff";
      }

      Box {
        orientation: vertical;
        margin-top: 18;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;
        spacing: 18;

        // ── Conflicted file path ──────────────────────────────────────
        Adw.PreferencesGroup {
          title: _("Changed File");

          Adw.ActionRow file_path_row {
            title: _("Path");
            subtitle-selectable: true;

            [prefix]
            Image {
              icon-name: "dialog-warning-symbolic";
              pixel-size: 32;

              styles ["warning"]
            }
          }
        }

        // ── Ours / Theirs info ────────────────────────────────────────
        Box {
          homogeneous: true;
          spacing: 12;

          // Ours
          Box {
            orientation: vertical;
            spacing: 6;
            hexpand: true;

            Label {
              label: _("First Parent");
              halign: start;

              styles ["heading"]
            }

            Frame {
              Adw.PreferencesGroup {
                Adw.ActionRow ours_commit_row {
                  title: _("Commit");
                  subtitle-selectable: true;
                }

                Adw.ActionRow ours_author_row {
                  title: _("Author");
                }

                Adw.ActionRow ours_date_row {
                  title: _("Date");
                }
              }
            }
          }

          // Theirs
          Box {
            orientation: vertical;
            spacing: 6;
            hexpand: true;

            Label {
              label: _("Second Parent");
              halign: start;

              styles ["heading"]
            }

            Frame {
              Adw.PreferencesGroup {
                Adw.ActionRow theirs_commit_row {
                  title: _("Commit");
                  subtitle-selectable: true;
                }

                Adw.ActionRow theirs_author_row {
                  title: _("Author");
                }

                Adw.ActionRow theirs_date_row {
                  title: _("Date");
                }
              }
            }
          }
        }

        // ── Diff preview (collapsible) ────────────────────────────────
        Expander diff_expander {
          label: _("Show conflict diff");
          margin-top: 6;

          ScrolledWindow {
            height-request: 160;

            TextView diff_view {
              editable: false;
              monospace: true;
              top-margin: 8;
              bottom-margin: 8;
              left-margin: 8;
              right-margin: 8;
              wrap-mode: none;

              styles ["card"]
            }
          }
        }

      }
    };
  };

  ShortcutController {
    Shortcut {
      trigger: "Escape";
      action: "action(dialog.close)";
    }
  }
}
