using Gtk 4.0;
using Adw 1;

template $NodePropertiesDialog : Adw.Dialog {
  title: _("Properties");
  content-width: 480;
  content-height: 620;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button favorite_button {
        icon-name: "star-outline-thick-symbolic";
        tooltip-text: _("Favorite");
        styles ["flat"]
      }

      [end]
      Button open_location_button {
        icon-name: "open-in-new-symbolic";
        tooltip-text: _("Open Location");
        styles ["flat"]
      }

      title-widget: Adw.WindowTitle dialog_title {
        title: "";
      };
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;
      propagate-natural-height: true;

      child: Box {
        orientation: vertical;
        spacing: 22;
        margin-top: 18;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        Box {
          orientation: vertical;
          spacing: 8;
          halign: center;

          Overlay {
            halign: center;

            child: Image icon_image {
              pixel-size: 96;
              icon-name: "text-x-generic-symbolic";
              halign: center;
            };

            [overlay]
            Button edit_icon_button {
              icon-name: "document-edit-symbolic";
              tooltip-text: _("Snapshot item");
              halign: end;
              valign: end;
              styles ["circular", "osd"]
            }
          }

          Label name_label {
            label: "";
            justify: center;
            wrap: true;
            wrap-mode: word_char;
            max-width-chars: 32;
            lines: 3;
            ellipsize: middle;
            halign: center;
            styles ["title-1"]
          }

          Label kind_label {
            label: "";
            halign: center;
            styles ["dim-label"]
          }

          Label summary_label {
            label: "";
            halign: center;
            styles ["caption", "dim-label"]
          }
        }

        Box {
          orientation: vertical;
          spacing: 0;
          styles ["properties-card"]

          Box {
            orientation: horizontal;
            spacing: 12;
            margin-top: 10;
            margin-bottom: 10;
            margin-start: 12;
            margin-end: 12;

            Box {
              orientation: vertical;
              hexpand: true;

              Label {
                label: _("Parent Folder");
                xalign: 0;
                styles ["caption", "dim-label"]
              }

              Label parent_folder_label {
                label: "";
                xalign: 0;
                ellipsize: middle;
              }
            }

            Button copy_path_button {
              icon-name: "edit-copy-symbolic";
              tooltip-text: _("Copy Path");
              valign: center;
              styles ["flat"]
            }
          }

          Separator {}

          Box {
            orientation: horizontal;
            spacing: 12;
            margin-top: 10;
            margin-bottom: 10;
            margin-start: 12;
            margin-end: 12;

            Box {
              orientation: vertical;
              hexpand: true;

              Label {
                label: _("Repository");
                xalign: 0;
                styles ["caption", "dim-label"]
              }

              Label repository_label {
                label: "";
                xalign: 0;
                ellipsize: middle;
              }
            }
          }
        }

        Box {
          orientation: vertical;
          spacing: 0;
          styles ["properties-card"]

          Box {
            orientation: vertical;
            margin-top: 10;
            margin-bottom: 10;
            margin-start: 12;
            margin-end: 12;

            Label {
              label: _("Modified");
              xalign: 0;
              styles ["caption", "dim-label"]
            }

            Label modified_label {
              label: "";
              xalign: 0;
              selectable: true;
              ellipsize: middle;
            }
          }

          Separator {}

          Box {
            orientation: vertical;
            margin-top: 10;
            margin-bottom: 10;
            margin-start: 12;
            margin-end: 12;

            Label {
              label: _("Created");
              xalign: 0;
              styles ["caption", "dim-label"]
            }

            Label created_label {
              label: "";
              xalign: 0;
              selectable: true;
              ellipsize: middle;
            }
          }
        }

        Box {
          orientation: vertical;
          spacing: 0;
          styles ["properties-card"]

          Box {
            orientation: horizontal;
            spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Label {
              label: _("Permissions");
              xalign: 0;
              hexpand: true;
            }

            Label permissions_label {
              label: "";
              xalign: 1;
              styles ["dim-label"]
            }

            Image {
              icon-name: "go-next-symbolic";
              pixel-size: 12;
              styles ["dim-label"]
            }
          }

          Separator {}

          Box {
            orientation: horizontal;
            spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Label {
              label: _("Git Snapshot");
              xalign: 0;
              hexpand: true;
            }

            Label snapshot_label {
              label: "";
              xalign: 1;
              ellipsize: middle;
              styles ["dim-label"]
            }
          }

          Separator {}

          Box {
            orientation: horizontal;
            spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Label {
              label: _("Git Object");
              xalign: 0;
              hexpand: true;
            }

            Label object_label {
              label: "";
              xalign: 1;
              ellipsize: middle;
              styles ["dim-label"]
            }
          }
        }

        Button copy_details_button {
          label: _("Copy Details");
          halign: center;
          styles ["pill"]
        }
      };
    };
  };
}
