using Gtk 4.0;
using Adw 1;

template $NewBranchDialog : Adw.Dialog {
  title: _("New Branch");
  content-width: 400;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("_Cancel");
        use-underline: true;
        can-shrink: true;
      }

      [end]
      Button create_button {
        label: _("_Create");
        use-underline: true;
        can-shrink: true;
        sensitive: false;

        styles ["suggested-action"]
      }
    }

    content: Adw.Clamp {
      maximum-size: 400;
      margin-top: 12;
      margin-bottom: 24;
      margin-start: 12;
      margin-end: 12;

      Box {
        orientation: vertical;
        spacing: 24;

        Adw.PreferencesGroup {
          title: _("Branch Details");

          Adw.EntryRow branch_name_entry {
            title: _("Branch Name");
          }
        }
      }
    };
  }
}
