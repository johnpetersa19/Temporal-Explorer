using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Navigation");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to Previous Commit");
      accelerator: "<alt>Left";
      direction: ltr;
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to Previous Commit");
      accelerator: "<alt>Right";
      direction: rtl;
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to Next Commit");
      accelerator: "<alt>Right";
      direction: ltr;
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to Next Commit");
      accelerator: "<alt>Left";
      direction: rtl;
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to First Commit");
      action-name: "win.first-commit";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to Latest Commit (HEAD)");
      action-name: "win.latest-commit";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Open Repository");
      action-name: "win.open-repository";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "New Tab");
      action-name: "win.new-tab";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Close Tab");
      action-name: "win.close-tab";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Refresh / Reload");
      action-name: "win.reload-repository";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Edit Snapshot Location");
      action-name: "win.edit-location";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go to Snapshot Root");
      action-name: "win.prompt-root-location";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Search & Filter");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Search Commits");
      action-name: "win.search-commits";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Open Filter Popover");
      action-name: "win.toggle-filter-popover";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Open Date Range Dialog");
      action-name: "win.open-date-range-dialog";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Filter by File Type");
      action-name: "win.filter-file-type";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Clear All Filters");
      action-name: "win.clear-all-filters";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "View");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "List View");
      action-name: "win.list-view";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Grid View");
      action-name: "win.grid-view";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Zoom In");
      action-name: "win.zoom-in";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Zoom Out");
      action-name: "win.zoom-out";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Reset Zoom");
      action-name: "win.reset-zoom";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Show/Hide Sidebar");
      action-name: "win.toggle-sidebar";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Choose Visible Columns");
      action-name: "win.show-column-chooser";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "File Grid Captions");
      action-name: "win.show-captions";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Commit Actions");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Copy Commit SHA");
      action-name: "win.copy-current-commit-sha";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Show Commit Details");
      action-name: "win.show-current-commit-details";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Preview Selected File");
      action-name: "win.preview-selected-file";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Open Context Menu");
      action-name: "win.open-context-menu";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Batch Operations on Commits");
      action-name: "win.batch-operations";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Compare Merge Parents");
      action-name: "win.show-merge-conflicts";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Selection");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Select All Files");
      action-name: "win.select-all-files";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Invert File Selection");
      action-name: "win.invert-file-selection";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Clear File Selection");
      action-name: "win.unselect-all-files";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Select Commits Matching Pattern");
      action-name: "win.select-by-pattern";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Invert Commit Selection");
      action-name: "win.invert-commit-selection";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "App");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Preferences");
      action-name: "app.preferences";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Quit");
      action-name: "app.quit";
    }
  }
}
