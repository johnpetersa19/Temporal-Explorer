using Gtk 4.0;

Gtk.ShortcutsWindow shortcuts_dialog {

  // ===== NAVIGATION =====
  Gtk.ShortcutsSection {
    title: C_("shortcuts dialog", "Navigation");
    section-name: "navigation";

    Gtk.ShortcutsGroup {
      title: "";

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Go to Previous Commit");
        accelerator: "<alt>Left";
        direction: ltr;
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Go to Previous Commit");
        accelerator: "<alt>Right";
        direction: rtl;
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Go to Next Commit");
        accelerator: "<alt>Right";
        direction: ltr;
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Go to Next Commit");
        accelerator: "<alt>Left";
        direction: rtl;
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Go to First Commit");
        accelerator: "<Primary>Home";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Go to Latest Commit (HEAD)");
        accelerator: "<Primary>End";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Open Repository");
        accelerator: "<Primary>o";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Refresh / Reload");
        accelerator: "F5";
      }
    }
  }

  // ===== SEARCH & FILTER =====
  Gtk.ShortcutsSection {
    title: C_("shortcuts dialog", "Search & Filter");
    section-name: "search";

    Gtk.ShortcutsGroup {
      title: "";

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Search Commits");
        accelerator: "<Primary>f";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Open Filter Popover");
        accelerator: "<Primary><Shift>f";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Open Date Range Dialog");
        accelerator: "<Primary><Shift>d";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Filter by File Type");
        accelerator: "<Primary><Shift>t";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Clear All Filters");
        accelerator: "<Primary>Escape";
      }
    }
  }

  // ===== VIEW =====
  Gtk.ShortcutsSection {
    title: C_("shortcuts dialog", "View");
    section-name: "view";

    Gtk.ShortcutsGroup {
      title: "";

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "List View");
        accelerator: "<Primary>1";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Grid View");
        accelerator: "<Primary>2";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Zoom In");
        accelerator: "<Primary>plus";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Zoom Out");
        accelerator: "<Primary>minus";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Reset Zoom");
        accelerator: "<Primary>0";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Show/Hide Sidebar");
        action-name: "win.toggle-sidebar";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Choose Visible Columns");
        accelerator: "<Primary><Shift>c";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "File Grid Captions");
        accelerator: "<Primary><Shift>g";
      }
    }
  }

  // ===== COMMIT ACTIONS =====
  Gtk.ShortcutsSection {
    title: C_("shortcuts dialog", "Commit Actions");
    section-name: "commits";

    Gtk.ShortcutsGroup {
      title: "";

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Copy Commit SHA");
        accelerator: "<Primary>c";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Show Commit Details");
        accelerator: "<Primary>i";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Preview Selected File");
        accelerator: "space";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Open Context Menu");
        accelerator: "<Shift>F10";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Batch Operations on Commits");
        accelerator: "<Primary><Shift>b";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Show Merge Conflicts");
        accelerator: "<Primary><Shift>m";
      }
    }
  }

  // ===== SELECTION =====
  Gtk.ShortcutsSection {
    title: C_("shortcuts dialog", "Selection");
    section-name: "selection";

    Gtk.ShortcutsGroup {
      title: "";

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Select All Commits");
        accelerator: "<Primary>a";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Select Commits Matching Pattern");
        accelerator: "<Primary>s";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Invert Selection");
        accelerator: "<Primary><Shift>i";
      }
    }
  }

  // ===== APP =====
  Gtk.ShortcutsSection {
    title: C_("shortcuts dialog", "App");
    section-name: "app";

    Gtk.ShortcutsGroup {
      title: "";

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Preferences");
        action-name: "app.preferences";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Show Shortcuts");
        action-name: "app.shortcuts";
      }

      Gtk.ShortcutsShortcut {
        title: C_("shortcuts dialog", "Quit");
        action-name: "app.quit";
      }
    }
  }
}
