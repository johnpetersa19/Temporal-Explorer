using Gtk 4.0;
using Adw 1;

template $TemporalToolbar : Adw.Bin {
  Adw.HeaderBar header_bar {
    show-start-title-buttons: true;
    show-end-title-buttons: true;

    [start]
    ToggleButton show_sidebar_button {
      icon-name: "sidebar-show-symbolic";
      tooltip-text: _("Show Sidebar");
      styles ["flat"]
    }

    [start]
    $HistoryControls history_controls {
      styles ["toolbar-history-controls"]
    }

    [title]
    Box header_toolbar {
      orientation: horizontal;
      spacing: 6;
      valign: center;
      styles ["header-toolbar-box"]

      Stack toolbar_switcher {
        valign: center;
        hexpand: false;
        transition-type: crossfade;
        transition-duration: 150;

        StackPage {
          name: "pathbar";
          child: Box {
            orientation: horizontal;
            valign: center;
            styles ["nautilus-pathbar"]

            ScrolledWindow address_bar_scrolled {
              hadjustment: Adjustment {};
              vadjustment: Adjustment {};
              hscrollbar-policy: automatic;
              vscrollbar-policy: never;
              propagate-natural-width: true;
              min-content-width: 320;
              max-content-width: 420;

              Box address_bar {
                orientation: horizontal;
                valign: center;
                styles ["nautilus-pathbar-segments"]
              }
            }
          };
        }

        StackPage {
          name: "location";
          child: Box {
            orientation: horizontal;
            width-request: 360;
            styles ["linked", "location-bar"]

            Entry location_entry {
              hexpand: true;
              placeholder-text: _("Type a path and press Enter…");
              input-purpose: url;
              primary-icon-name: "folder-symbolic";
            }

            Button location_cancel_btn {
              icon-name: "window-close-symbolic";
              tooltip-text: _("Cancel");
            }
          };
        }
      }

      Stack search_button_stack {
        hhomogeneous: true;
        transition-type: crossfade;

        ToggleButton search_button {
          tooltip-text: _("Search Commits");
          halign: center;
          valign: center;
          icon-name: "nautilus-folder-search-symbolic";
          styles ["flat"]
        }

        Adw.Bin search_button_placeholder {}
      }
    }

    [end]
    $ViewControls view_controls {}

    [end]
    MenuButton main_menu_button {
      primary: true;
      icon-name: "view-more-symbolic";
      tooltip-text: _("Main Menu");
      menu-model: primary_menu;
      styles ["flat"]
    }

    // Kept as hidden template children because toolbar.rs/window.rs still use them.
    [end]
    Button open_repo_button {
      visible: false;
      icon-name: "folder-open-symbolic";
      tooltip-text: _("Open Repository");
      styles ["flat"]
    }

    [end]
    Button new_branch_button {
      visible: false;
      icon-name: "list-add-symbolic";
      tooltip-text: _("New Branch");
      action-name: "win.new-branch";
      styles ["flat"]
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("Open Repository");
      action: "win.open-repository";
    }

    item {
      label: _("Clone Repository");
      action: "win.clone-repository";
    }

    item {
      label: _("New Branch");
      action: "win.new-branch";
    }

    item {
      label: _("Reload");
      action: "win.reload-repository";
      accel: "F5";
    }
  }

  section {
    submenu {
      label: _("Location");

      section {
        item {
          label: _("Edit Snapshot Location");
          action: "win.edit-location";
          accel: "<control>l";
        }

        item {
          label: _("Go to Snapshot Root");
          action: "win.prompt-root-location";
          accel: "/";
        }

        item {
          label: _("Copy Snapshot Location");
          action: "win.copy-current-location";
        }
      }
    }

    submenu {
      label: _("Repository");

      section {
        item {
          label: _("Open Repository in System");
          action: "win.open-repository-system";
        }

        item {
          label: _("Open in Console");
          action: "win.open-repository-console";
        }

        item {
          label: _("Copy Repository Path");
          action: "win.copy-current-repository-path";
        }
      }
    }
  }

  section {
    submenu {
      label: _("Selection");

      section {
        item {
          label: _("Select All");
          action: "win.select-all-files";
          accel: "<control>a";
        }

        item {
          label: _("Invert Selection");
          action: "win.invert-file-selection";
          accel: "<control><shift>a";
        }

        item {
          label: _("Clear Selection");
          action: "win.unselect-all-files";
        }
      }
    }

    submenu {
      label: _("View");

      section {
        item {
          label: _("Captions…");
          action: "win.show-captions";
        }

        item {
          label: _("Visible Columns…");
          action: "win.show-column-chooser";
        }

        item {
          label: _("Select Commits by Pattern…");
          action: "win.select-by-pattern";
        }
      }
    }

    submenu {
      label: _("File");

      section {
        item {
          label: _("Properties");
          action: "win.current-properties";
        }

        item {
          label: _("Preview Selected File");
          action: "win.preview-selected-file";
        }

        item {
          label: _("Show Context Menu");
          action: "win.open-context-menu";
        }
      }
    }

    submenu {
      label: _("Operations");

      section {
        item {
          label: _("Batch Operations…");
          action: "win.batch-operations";
        }

        item {
          label: _("Compare Merge Parents…");
          action: "win.show-merge-conflicts";
        }
      }
    }
  }

  section {
    submenu {
      label: _("Help");

      section {
        item {
          label: _("Preferences");
          action: "app.preferences";
        }

        item {
          label: _("Keyboard Shortcuts");
          action: "app.shortcuts";
        }

        item {
          label: _("About Temporal Explorer");
          action: "app.about";
        }
      }
    }
  }
}
