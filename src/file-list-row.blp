using Gtk 4.0;
using Adw 1;

/* Rust sets: title (name), file_row_ext_label.label, file_row_submodule_badge.label,
              file_row_icon.icon-name, file_row_chevron.visible */
template $FileListRow : Adw.ActionRow {
  activatable: true;

  [prefix]
  Image file_row_icon {
    pixel-size: 16;
    valign: center;
  }

  [suffix]
  Label file_row_ext_label {
    label: "";
    visible: false;
    valign: center;
    styles ["caption", "dim-label"]
  }

  [suffix]
  Label file_row_submodule_badge {
    label: "submodule";
    visible: false;
    valign: center;
    styles ["caption", "dim-label"]
  }

  [suffix]
  Image file_row_chevron {
    icon-name: "go-next-symbolic";
    pixel-size: 12;
    visible: false;
    valign: center;
    styles ["dim-label"]
  }
}
