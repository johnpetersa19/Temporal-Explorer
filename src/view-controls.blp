using Gtk 4.0;
using Adw 1;

menu view_menu {
  section {
    label: _("Icon Size");
    display-hint: "inline-buttons";

    item {
      custom: "zoom-out";
    }

    item {
      custom: "zoom-in";
    }
  }

  section {
    label: _("Sort");

    item {
      label: _("A-Z");
      action: "viewctrl.sort";
      target: "name";
    }

    item {
      label: _("Z-A");
      action: "viewctrl.sort";
      target: "name-desc";
    }

    item {
      label: _("Last Modified");
      action: "viewctrl.sort";
      target: "last-modified";
    }

    item {
      label: _("First Modified");
      action: "viewctrl.sort";
      target: "first-modified";
    }

    item {
      label: _("Size");
      action: "viewctrl.sort";
      target: "size";
    }

    item {
      label: _("Type");
      action: "viewctrl.sort";
      target: "type";
    }
  }

  section {
    item {
      label: _("Show Hidden Files");
      action: "viewctrl.show-hidden-files";
      accel: "<control>h";
    }
  }

  section {
    item {
      label: _("Captions…");
      action: "viewctrl.captions";
    }
  }
}

template $ViewControls : Gtk.Box {
  orientation: horizontal;
  spacing: 4;

  ToggleButton list_view_button {
    icon-name: "view-list-symbolic";
    tooltip-text: _("List view");
    active: true;
    toggled => $on_list_toggled() swapped;

    styles ["flat"]
  }

  ToggleButton grid_view_button {
    icon-name: "view-grid-symbolic";
    tooltip-text: _("Grid view");
    group: list_view_button;
    toggled => $on_grid_toggled() swapped;

    styles ["flat"]
  }

  Separator {
    orientation: vertical;
    margin-start: 2;
    margin-end: 2;
  }

  MenuButton view_options_button {
    tooltip-text: _("View Options");

    styles ["flat"]

    child: Box {
      orientation: horizontal;
      spacing: 6;

      Label view_options_label {
        label: _("Name");
        valign: center;
      }

      Image {
        icon-name: "pan-down-symbolic";
        valign: center;
      }
    };

    popover: PopoverMenu {
      menu-model: view_menu;

      [zoom-out]
      Button zoom_out_button {
        icon-name: "zoom-out-symbolic";
        tooltip-text: _("Zoom Out");
        clicked => $on_zoom_out_clicked() swapped;

        styles ["flat"]
      }

      [zoom-in]
      Button zoom_in_button {
        icon-name: "zoom-in-symbolic";
        tooltip-text: _("Zoom In");
        clicked => $on_zoom_in_clicked() swapped;

        styles ["flat"]
      }
    };
  }
}
