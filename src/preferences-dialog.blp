using Gtk 4.0;
using Adw 1;

template $PreferencesDialog : Adw.PreferencesDialog {
  search-enabled: true;

  // ── Page: General ───────────────────────────────────────────────────────
  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Repository");
      description: _("Behaviour when opening and loading repositories.");

      Adw.SwitchRow fetch_on_open_row {
        title: _("_Fetch on Open");
        subtitle: _("Run git fetch automatically when a repository is opened.");
        use-underline: true;
      }

      Adw.SpinRow commits_per_page_row {
        title: _("_Commits per Page");
        subtitle: _("Number of commits loaded in each batch.");
        use-underline: true;

        adjustment: Adjustment {
          lower: 10;
          upper: 500;
          step-increment: 10;
          page-increment: 50;
        };
      }

      Adw.EntryRow default_branch_row {
        title: _("_Default Branch");
        use-underline: true;
      }

      Adw.SpinRow clone_depth_row {
        title: _("Shallow Clone _Depth");
        subtitle: _("Set to 0 to clone the full history.");
        use-underline: true;

        adjustment: Adjustment {
          lower: 0;
          upper: 10000;
          step-increment: 1;
          page-increment: 100;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Date and Time");
      description: _("Choose how commit timestamps are displayed.");

      Adw.ActionRow date_format_relative_row {
        title: _("_Relative");
        subtitle: _("e.g. \"3 days ago\"");
        use-underline: true;

        [prefix]
        CheckButton date_format_relative_button {
          valign: center;
          action-name: "preferences.date-format";
          action-target: "'relative'";
        }

        activatable-widget: date_format_relative_button;
      }

      Adw.ActionRow date_format_short_row {
        title: _("_Short");
        subtitle: _("e.g. \"13 Jun 2026\"");
        use-underline: true;

        [prefix]
        CheckButton date_format_short_button {
          group: date_format_relative_button;
          valign: center;
          action-name: "preferences.date-format";
          action-target: "'short'";
        }

        activatable-widget: date_format_short_button;
      }

      Adw.ActionRow date_format_iso_row {
        title: _("_ISO 8601");
        subtitle: _("e.g. \"2026-06-13 14:30:00\"");
        use-underline: true;

        [prefix]
        CheckButton date_format_iso_button {
          group: date_format_relative_button;
          valign: center;
          action-name: "preferences.date-format";
          action-target: "'iso'";
        }

        activatable-widget: date_format_iso_button;
      }
    }
  }

  // ── Page: Appearance ──────────────────────────────────────────────────
  Adw.PreferencesPage {
    title: _("Appearance");
    icon-name: "applications-graphics-symbolic";

    Adw.PreferencesGroup {
      title: _("Color Scheme");

      Adw.ActionRow color_scheme_light_row {
        title: _("_Light");
        use-underline: true;

        [prefix]
        CheckButton color_scheme_light_button {
          valign: center;
          action-name: "preferences.color-scheme";
          action-target: "'light'";
        }

        activatable-widget: color_scheme_light_button;
      }

      Adw.ActionRow color_scheme_dark_row {
        title: _("_Dark");
        use-underline: true;

        [prefix]
        CheckButton color_scheme_dark_button {
          group: color_scheme_light_button;
          valign: center;
          action-name: "preferences.color-scheme";
          action-target: "'dark'";
        }

        activatable-widget: color_scheme_dark_button;
      }

      Adw.ActionRow color_scheme_auto_row {
        title: _("_System");
        subtitle: _("Follow the system color scheme.");
        use-underline: true;

        [prefix]
        CheckButton color_scheme_auto_button {
          group: color_scheme_light_button;
          valign: center;
          action-name: "preferences.color-scheme";
          action-target: "'auto'";
        }

        activatable-widget: color_scheme_auto_button;
      }
    }

    Adw.PreferencesGroup {
      title: _("Timeline");

      Adw.SwitchRow show_avatars_row {
        title: _("Show Author _Avatars");
        subtitle: _("Display author initials in commit rows.");
        use-underline: true;
      }

      Adw.SwitchRow show_diff_stat_row {
        title: _("Show _Diff Statistics");
        subtitle: _("Display +N −N emblems in commit rows.");
        use-underline: true;
      }

      Adw.SwitchRow compact_rows_row {
        title: _("_Compact Rows");
        subtitle: _("Reduce vertical padding in the commit list.");
        use-underline: true;
      }
    }
  }

  // ── Page: Advanced ───────────────────────────────────────────────────
  Adw.PreferencesPage {
    title: _("Advanced");
    icon-name: "applications-engineering-symbolic";

    Adw.PreferencesGroup {
      title: _("Git");

      Adw.EntryRow git_binary_row {
        title: _("_Git Binary Path");
        subtitle: _("Leave empty to use the system default.");
        use-underline: true;
      }

      Adw.SwitchRow follow_renames_row {
        title: _("_Follow Renames");
        subtitle: _("Track file history across renames (git log --follow).");
        use-underline: true;
      }

      Adw.SwitchRow show_signature_row {
        title: _("Show _GPG Signature Status");
        subtitle: _("Verify and display commit signature badges.");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Performance");

      Adw.SpinRow cache_size_row {
        title: _("_Cache Size (MB)");
        subtitle: _("Maximum memory used for the directory cache.");
        use-underline: true;

        adjustment: Adjustment {
          lower: 16;
          upper: 1024;
          step-increment: 16;
          page-increment: 128;
        };
      }

      Adw.SwitchRow background_index_row {
        title: _("_Background Indexing");
        subtitle: _("Pre-index large repositories in the background.");
        use-underline: true;
      }
    }
  }
}
