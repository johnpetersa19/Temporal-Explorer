using Gtk 4.0;
using Adw 1;

template $PreferencesDialog : Adw.PreferencesDialog {
  search-enabled: true;

  Adw.PreferencesPage {
    title: _("General");

    Adw.PreferencesGroup {
      title: _("Repository");

      Adw.SwitchRow fetch_on_open_row {
        title: _("Fetch on Open");
        subtitle: _("Refresh remote tracking branches when a repository is opened.");
      }

      Adw.SpinRow commits_per_page_row {
        title: _("Commits per Page");
        subtitle: _("How many commits to load in each batch.");

        adjustment: Adjustment {
          lower: 10;
          upper: 500;
          step-increment: 10;
          page-increment: 50;
        };
      }

      Adw.EntryRow default_branch_row {
        title: _("Default Branch");
      }

      Adw.SpinRow clone_depth_row {
        title: _("Shallow Clone Depth");
        subtitle: _("Set to 0 to clone the full history.");

        adjustment: Adjustment {
          lower: 0;
          upper: 10000;
          step-increment: 1;
          page-increment: 100;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Date and Time");

      Adw.ActionRow date_format_relative_row {
        title: _("Relative");
        subtitle: _("Example: 3 days ago");

        [prefix]
        CheckButton date_format_relative_button {
          valign: center;
          action-name: "preferences.date-format";
          action-target: "'relative'";
        }

        activatable-widget: date_format_relative_button;
      }

      Adw.ActionRow date_format_short_row {
        title: _("Short");
        subtitle: _("Example: 13 Jun 2026");

        [prefix]
        CheckButton date_format_short_button {
          group: date_format_relative_button;
          valign: center;
          action-name: "preferences.date-format";
          action-target: "'short'";
        }

        activatable-widget: date_format_short_button;
      }

      Adw.ActionRow date_format_iso_row {
        title: _("ISO 8601");
        subtitle: _("Example: 2026-06-13 14:30:00");

        [prefix]
        CheckButton date_format_iso_button {
          group: date_format_relative_button;
          valign: center;
          action-name: "preferences.date-format";
          action-target: "'iso'";
        }

        activatable-widget: date_format_iso_button;
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Appearance");

    Adw.PreferencesGroup {
      title: _("File Browser");

      Adw.ComboRow default_view_row {
        title: _("Default View");

        model: StringList {
          strings [
            _("List"),
            _("Grid"),
          ]
        };
      }

      Adw.ComboRow grid_zoom_row {
        title: _("Default Grid Zoom");

        model: StringList {
          strings [
            _("Small"),
            _("Normal"),
            _("Large"),
          ]
        };
      }

      Adw.ComboRow file_sort_row {
        title: _("Default Sort Order");

        model: StringList {
          strings [
            _("A-Z"),
            _("Z-A"),
            _("Last Modified"),
            _("First Modified"),
            _("Size"),
            _("Type"),
          ]
        };
      }

      Adw.SwitchRow show_hidden_files_row {
        title: _("Show Hidden Files");
      }
    }

    Adw.PreferencesGroup {
      title: _("Grid Captions");

      Adw.SwitchRow caption_status_row {
        title: _("Status");
      }

      Adw.SwitchRow caption_extension_row {
        title: _("File Extension");
      }

      Adw.SwitchRow caption_size_row {
        title: _("Size");
      }

      Adw.SwitchRow caption_date_row {
        title: _("Date");
      }
    }

    Adw.PreferencesGroup {
      title: _("Commit List");

      Adw.SwitchRow show_avatars_row {
        title: _("Show Author Avatars");
      }

      Adw.SwitchRow dense_mode_row {
        title: _("Dense Mode");
      }

      Adw.SwitchRow show_graph_row {
        title: _("Show Branch Graph");
      }
    }

    Adw.PreferencesGroup {
      title: _("Diff View");

      Adw.SwitchRow syntax_highlight_row {
        title: _("Syntax Highlighting");
      }

      Adw.SwitchRow word_diff_row {
        title: _("Word-level Diff");
      }

      Adw.SpinRow context_lines_row {
        title: _("Context Lines");

        adjustment: Adjustment {
          lower: 0;
          upper: 20;
          step-increment: 1;
          page-increment: 3;
        };
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Advanced");

    Adw.PreferencesGroup {
      title: _("Git");

      Adw.SwitchRow verify_signatures_row {
        title: _("Verify Commit Signatures");
      }

      Adw.SwitchRow follow_renames_row {
        title: _("Follow Renames");
      }

      Adw.SwitchRow include_submodules_row {
        title: _("Include Submodules");
      }
    }

    Adw.PreferencesGroup {
      title: _("Performance");

      Adw.SwitchRow background_fetch_row {
        title: _("Background Fetch");
      }

      Adw.SpinRow background_fetch_interval_row {
        title: _("Fetch Interval (minutes)");

        adjustment: Adjustment {
          lower: 5;
          upper: 1440;
          step-increment: 5;
          page-increment: 30;
        };
      }
    }
  }
}
