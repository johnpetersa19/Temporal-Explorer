using Gtk 4.0;
using Adw 1;

template $SearchFilterPopover : Popover {
  position: bottom;

  child: ScrolledWindow {
    propagate-natural-height: true;
    propagate-natural-width: true;

    child: Box {
      orientation: vertical;
      spacing: 12;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;
      width-request: 340;

      /* ── File type filter — same position as Nautilus ─────────────── */
      Box {
        orientation: vertical;
        spacing: 6;

        Label {
          label: _("File Types");
          xalign: 0;
          valign: baseline;
          styles ["heading"]
        }

        Adw.WrapBox file_type_chips_box {
          child-spacing: 6;
          line-spacing: 6;
          natural-line-length: 340;

          Button file_type_audio_button {
            accessible-role: checkbox;
            child: Adw.ButtonContent {
              icon-name: "audio-x-generic-symbolic";
              label: _("Audio");
            };
          }

          Button file_type_documents_button {
            accessible-role: checkbox;
            child: Adw.ButtonContent {
              icon-name: "rich-text-symbolic";
              label: _("Documents");
            };
          }

          Button file_type_folders_button {
            accessible-role: checkbox;
            child: Adw.ButtonContent {
              icon-name: "folder-symbolic";
              label: _("Folders");
            };
          }

          Button file_type_images_button {
            accessible-role: checkbox;
            child: Adw.ButtonContent {
              icon-name: "image-print-symbolic";
              label: _("Images");
            };
          }

          Button file_type_pdf_button {
            accessible-role: checkbox;
            child: Adw.ButtonContent {
              icon-name: "rich-text-symbolic";
              label: "PDF";
            };
          }

          Button file_type_text_button {
            accessible-role: checkbox;
            child: Adw.ButtonContent {
              icon-name: "paper-symbolic";
              label: _("Text");
            };
          }

          Button file_type_videos_button {
            accessible-role: checkbox;
            child: Adw.ButtonContent {
              icon-name: "camera-video-symbolic";
              label: _("Videos");
            };
          }

          Button file_type_other_button {
            icon-name: "view-more-horizontal-symbolic";
            tooltip-text: _("Specific Type");
            styles ["circular"]
          }
        }
      }

      /* ── Date filter — Nautilus-like “Last Modified” section ──────── */
      Box {
        orientation: vertical;
        spacing: 6;

        Box {
          spacing: 6;

          Label date_header {
            label: _("Last Modified");
            hexpand: true;
            xalign: 0;
            valign: baseline;
            styles ["heading"]
          }

          Button clear_date_button {
            icon-name: "edit-clear-symbolic";
            tooltip-text: _("Clear Date Filter");
            visible: false;
            styles ["flat", "circular"]
          }
        }

        Adw.WrapBox date_chips_box {
          child-spacing: 6;
          line-spacing: 6;
          natural-line-length: 340;

          Button today_button {
            label: _("_Today");
            use-underline: true;
            accessible-role: checkbox;
          }

          Button yesterday_button {
            label: _("_Yesterday");
            use-underline: true;
            accessible-role: checkbox;
          }

          Button last_week_button {
            label: _("Past _Week");
            use-underline: true;
            accessible-role: checkbox;
          }

          Button last_month_button {
            label: _("Past _Month");
            use-underline: true;
            accessible-role: checkbox;
          }

          Button last_year_button {
            label: _("Past Y_ear");
            use-underline: true;
            accessible-role: checkbox;
          }

          Button custom_range_chip {
            visible: false;
            accessible-role: checkbox;
          }

          Button custom_range_button {
            icon-name: "view-more-horizontal-symbolic";
            tooltip-text: _("Custom Date Range");
            styles ["circular"]
          }
        }
      }

      /* ── Text matching — Nautilus visual section.
       * In Temporal Explorer the timeline SearchEntry controls the text query.
       */
      Box {
        orientation: vertical;
        spacing: 6;

        Label {
          label: _("Text Matching");
          xalign: 0;
          valign: baseline;
          styles ["heading"]
        }

        Adw.WrapBox {
          child-spacing: 6;
          line-spacing: 6;
          natural-line-length: 340;

          Button {
            label: _("Content & Filename");
            tooltip-text: _("Search commit text and changed file names");
            sensitive: false;
            styles ["suggested-action"]
          }

          Button {
            label: _("Only Filename");
            tooltip-text: _("Filename-only search is not available in this view");
            sensitive: false;
          }
        }
      }

      Separator {}

      /* ── Git-specific filters kept after Nautilus sections ────────── */
      Box {
        orientation: vertical;
        spacing: 8;

        Box {
          spacing: 6;

          Label author_header {
            label: _("Author");
            hexpand: true;
            xalign: 0;
            valign: baseline;
            styles ["heading"]
          }

          Button clear_author_button {
            icon-name: "edit-clear-symbolic";
            tooltip-text: _("Clear Author Filter");
            visible: false;
            styles ["flat", "circular"]
          }
        }

        SearchEntry author_entry {
          placeholder-text: _("Filter by author name or email…");
          hexpand: true;
        }

        ScrolledWindow {
          min-content-height: 120;
          max-content-height: 120;
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;
          propagate-natural-height: false;

          child: Box author_chips_box {
            orientation: vertical;
            spacing: 6;
          };
        }
      }

      Box {
        orientation: vertical;
        spacing: 8;

        Box {
          spacing: 6;

          Label branch_header {
            label: _("Branch");
            hexpand: true;
            xalign: 0;
            valign: baseline;
            styles ["heading"]
          }

          Button clear_branch_button {
            icon-name: "edit-clear-symbolic";
            tooltip-text: _("Clear Branch Filter");
            visible: false;
            styles ["flat", "circular"]
          }
        }

        Adw.WrapBox branch_chips_box {
          child-spacing: 6;
          line-spacing: 6;
          natural-line-length: 340;
        }
      }

      Box {
        halign: end;

        Button reset_all_button {
          label: _("Reset Filters");
          styles ["destructive-action"]
        }
      }
    };
  };
}
