<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.johnpetersa19.TemporalExplorer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Temporal Explorer</name>
  <summary>Navigate your repository history as a file tree</summary>
  <description>
    <p>
      Temporal Explorer is a time-travel tool for Git repositories hosted on any
      forge such as GitHub, GitLab, Codeberg, Gitea, Forgejo, Bitbucket, and Azure DevOps.
    </p>
    <p>
      Instead of using complex VCS commands, Temporal Explorer reads the native
      history of your repository and reconstructs the complete directory tree as
      it existed at any chosen commit. Browse deleted files, compare old versions,
      and copy files from the past — all without touching your current working tree.
    </p>
  </description>

  <developer id="io.github.johnpetersa19">
    <name>John Peter Sá</name>
  </developer>

  <url type="homepage">https://github.com/johnpetersa19/Temporal-Explorer</url>
  <url type="vcs-browser">https://github.com/johnpetersa19/Temporal-Explorer</url>
  <url type="bugtracker">https://github.com/johnpetersa19/Temporal-Explorer/issues</url>

  <translation type="gettext">temporal-explorer</translation>
  <launchable type="desktop-id">io.github.johnpetersa19.TemporalExplorer.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-06-06">
      <description translate="no">
        <p>Initial release.</p>
      </description>
    </release>
  </releases>

</component>
